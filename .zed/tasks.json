[
  {
    "label": "Configure Debug",
    "command": "cmake",
    "args": [
      "--preset",
      "debug"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Build Debug",
    "command": "cmake",
    "args": [
      "--build",
      "--preset",
      "debug"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Run Debug",
    "command": "cmake",
    "args": [
      "--build",
      "--preset",
      "run-debug"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false
  },
  {
    "label": "Configure Release",
    "command": "cmake",
    "args": [
      "--preset",
      "release"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Build Release",
    "command": "cmake",
    "args": [
      "--build",
      "--preset",
      "release"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Run Release",
    "command": "cmake",
    "args": [
      "--build",
      "--preset",
      "run-release"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false
  }
]
